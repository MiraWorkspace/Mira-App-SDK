{
  "name": "@mira/app-sdk",
  "version": "0.2.0",
  "description": "Typed client SDK for applications hosted by Mira",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "doc"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiraWorkspace/Mira-App-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/MiraWorkspace/Mira-App-SDK/issues"
  },
  "homepage": "https://github.com/MiraWorkspace/Mira-App-SDK#readme"
}
